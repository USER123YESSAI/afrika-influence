DB_HOST=localhost
DB_PORT=3306
DB_NAME=afrika_influence
DB_USER=root
DB_PASS=

# Génère une valeur aléatoire avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obligatoire en production (le serveur refuse de démarrer sans elle).
JWT_SECRET=

# ENABLE_MOCK_AUTH=true active le token MOCK_TOKEN_DEV pour débloquer P2/P3
# avant que le vrai JWT soit prêt. Ne JAMAIS mettre à true en production
# (le serveur l'ignore de toute façon si NODE_ENV=production).
ENABLE_MOCK_AUTH=true

TAUX_COMMISSION=10

PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test

BREVO_API_KEY=

UPLOAD_PATH=./uploads/logos
MAX_FILE_SIZE=5242880

PORT=3001
NODE_ENV=development

# Origine(s) autorisée(s) par CORS, séparées par des virgules. Doit
# correspondre à l'URL du FRONTEND (pas de l'API elle-même).
CORS_ORIGINS=http://localhost:3000

# Utilisée pour construire le lien envoyé par email lors d'une demande de
# réinitialisation de mot de passe.
FRONTEND_URL=http://localhost:3000
